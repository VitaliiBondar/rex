# Скопіюйте у .env і заповніть власними значеннями (.env у git не потрапляє).

DATABASE_URL="file:./dev.db"

# Згенерувати: openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_TRUST_HOST=true

# Паролі для demo-акаунтів, які створює `npm run db:seed`.
# Якщо не задати — використовуються дефолти для локальної розробки (admin123 / recruiter123).
# ОБОВ'ЯЗКОВО задайте власні перед запуском seed на будь-якій недовірчій/продакшн базі.
SEED_ADMIN_PASSWORD="change-me"
SEED_RECRUITER_PASSWORD="change-me"
